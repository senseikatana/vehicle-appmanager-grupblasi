# ==============================================================================
# Prisma + Cloudflare D1 — plantilla local
# Copia este archivo como .env y ajusta cuando tengas credenciales reales
# ==============================================================================

# Local: SQLite espejo del esquema D1 (migraciones con prisma migrate diff)
DATABASE_URL="file:./prisma/dev.db"

# Remoto D1 (pendiente de credenciales — me las pasarás más adelante)
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_DATABASE_ID=""
# CLOUDFLARE_D1_TOKEN=""

# D1 local via wrangler (nombre del binding en wrangler.jsonc)
# D1_DATABASE_NAME="vehicle-appmanager-d1"

# PRISMA_TELEMETRY_DISABLED=1

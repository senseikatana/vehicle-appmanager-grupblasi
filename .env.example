# ==============================================================================
# 🔷 Prisma DATABASE_URL — plantilla
# Copia este archivo como .env y rellena los valores reales
# ==============================================================================

DATABASE_URL="postgresql://postgres.PROJECT_REF:password@db.REGION.insforge.ai:5432/postgres"
# InsForge usa PostgreSQL. Obtén tu DATABASE_URL:
#   1. insforge link  (vincula el directorio al proyecto)
#   2. insforge metadata  (muestra la URL de conexión)
#   3. Copia la URL de PostgreSQL aquí
# InsForge usa pooler. Para migraciones directas, descomenta DIRECT_URL:
# DIRECT_URL="postgresql://user:password@host:5432/mydb?sslmode=require"

# PRISMA_TELEMETRY_DISABLED=1

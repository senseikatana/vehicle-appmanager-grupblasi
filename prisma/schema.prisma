// Esquema base local (SQLite) compatible con Cloudflare D1.
// En D1 las migraciones se aplican con: wrangler d1 execute --local/--remote
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "cloudflare"
}

// Cliente Node para el servidor Nitro en local (el runtime cloudflare no resuelve en Node).
generator server {
  provider = "prisma-client"
  output   = "../generated/server"
}

datasource db {
  provider = "sqlite"
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  WORKSHOP
  RETIRED
}

enum MaintenanceKind {
  PREVENTIVE
  CORRECTIVE
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// Roles interdepartamentales (AGENTS.md, módulo 11).
enum Role {
  ADMIN
  GESTOR_FLOTA
  TECNICO
  EMPLEADO
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EMPLEADO)
  createdAt    DateTime  @default(now())

  sessions Session[]
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Vehicle {
  id          Int           @id @default(autoincrement())
  plate       String        @unique
  brand       String
  model       String
  vehicleType String
  year        Int
  fuel        String
  mileage     Int           @default(0)
  status      VehicleStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  assignments  Assignment[]
  maintenances Maintenance[]
  documents    LegalDocument[]
  incidents    Incident[]
  costs        CostEntry[]
}

model Assignment {
  id         Int       @id @default(autoincrement())
  vehicleId  Int
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignee   String
  department String?
  site       String?
  startAt    DateTime  @default(now())
  endAt      DateTime?
  active     Boolean   @default(true)

  @@index([vehicleId, active])
}

model Maintenance {
  id        Int             @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind      MaintenanceKind
  date      DateTime        @default(now())
  mileage   Int?
  cost      Float           @default(0)
  provider  String?
  notes     String?

  @@index([vehicleId, date])
}

model LegalDocument {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  docType   String
  expiresAt DateTime
  fileUrl   String?
  notes     String?

  @@index([expiresAt])
  @@index([vehicleId])
}

model Incident {
  id          Int            @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  status      IncidentStatus @default(OPEN)
  description String
  cost        Float          @default(0)
  createdAt   DateTime       @default(now())
  closedAt    DateTime?

  @@index([vehicleId, status])
}

model CostEntry {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category  String
  amount    Float
  date      DateTime @default(now())
  notes     String?

  @@index([vehicleId, date])
}
